---
interface Props {
  AUTHOR_: string;
  LAST_UPDATED: string;
}
import { ArrowLeft, Calendar, BookOpen } from 'lucide-react';
const { AUTHOR_, LAST_UPDATED } = Astro.props;
import bgImg from '~/assets/images/best-forex-brokers-kenyaforexfirm.png';

import { getImage } from 'astro:assets';
const optimizedBackground = await getImage({ src: bgImg, format: 'webp' });
---

{/* Hero Section */}
<div class="bg-brand-900 text-white relative overflow-hidden">
  <div
    style={`background-image: url('${optimizedBackground.src}'); background-size: cover;`}
    class="absolute inset-0 opacity-5 backdrop-blur-sm"
  >
  </div>
  <div
    class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-emerald-900/20 to-transparent"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-24 pb-20 relative z-10">
    <div class="flex flex-col md:flex-row gap-12 items-start">
      <div class="md:w-3/4">
        <a
          href="/academy"
          class="inline-flex items-center text-emerald-400 hover:text-white mb-6 transition font-bold text-xs uppercase tracking-wider"
        >
          <ArrowLeft
            size={14}
            className="mr-2"
          />{' '}
          Academy / Broker Deep Dives
        </a>
        <h1
          class="text-slate-100 text-3xl md:text-5xl lg:text-6xl font-serif font-bold mb-8 leading-tight"
        >
          Pepperstone Kenya: <br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-200"
          >
            The Truth About Bonuses
          </span>{' '}
          & Real Value.
        </h1>
        <div
          class="flex flex-wrap items-center gap-6 text-slate-400 text-sm border-t border-brand-800 pt-6"
        >
          <div class="flex items-center gap-3">
            <img
              src="https://images.unsplash.com/photo-1556157382-97eda2d62296?auto=format&fit=crop&q=80&w=100"
              alt={AUTHOR_}
              class="w-10 h-10 rounded-full border-2 border-brand-700"
            />
            <div>
              <p class="text-white font-bold">{AUTHOR_}</p>
              <p class="text-xs">Market Analyst</p>
            </div>
          </div>
          <div class="h-8 w-px bg-brand-800 hidden sm:block"></div>
          <div class="flex items-center gap-2">
            <Calendar size={16} />
            <span>Updated {LAST_UPDATED}</span>
          </div>
          <div class="flex items-center gap-2">
            <BookOpen size={16} />
            <span>8 min read</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
