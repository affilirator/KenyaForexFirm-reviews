---
import { AlertTriangle, CheckCircle, Target } from 'lucide-react';

const styles = {
  info: {
    bg: 'bg-emerald-50',
    border: 'border-teal-200',
    text: 'text-blue-900',
    icon: Target,
  },
  warning: {
    bg: 'bg-amber-50',
    border: 'border-amber-200',
    text: 'text-amber-900',
    icon: AlertTriangle,
  },
  success: {
    bg: 'bg-emerald-50',
    border: 'border-emerald-200',
    text: 'text-emerald-900',
    icon: CheckCircle,
  },
};

const { title, type = 'info' } = Astro.props;

// @ts-ignore
const StyleConfig = styles[type];
const Icon = StyleConfig.icon;
---

<div
  class={`${StyleConfig.bg} border-l-4 ${StyleConfig.border} p-5 rounded-r-lg mb-8 shadow-sm`}
>
  <div class="flex items-start gap-3">
    <Icon
      class={`${type === 'info' ? 'text-emerald-600' : type === 'warning' ? 'text-amber-600' : 'text-emerald-600'} flex-shrink-0 mt-1`}
      size={20}
    />
    <div>
      {title && <h4 class={`font-bold ${StyleConfig.text} mb-1`}>{title}</h4>}
      <div class="text-slate-700 leading-relaxed">
        <slot />
      </div>
    </div>
  </div>
</div>
