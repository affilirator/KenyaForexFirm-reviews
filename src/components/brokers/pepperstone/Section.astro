---
const { id, title, icon: Icon } = Astro.props;
---

<section
  id={id}
  class="mb-14 scroll-mt-28 font-body max-w-4xl mx-auto"
>
  <div class="flex items-center gap-3 mb-6 border-b border-slate-100 pb-4">
    {
      Icon && (
        <div class="p-2 bg-emerald-100 rounded-lg text-cyan-700">
          <Icon size={24} />
        </div>
      )
    }
    <h2
      class="m-1 text-2xl text-left md:text-3xl font-bold text-slate-950 tracking-tight font-display"
    >
      {title}
    </h2>
  </div>
  <slot />
</section>
