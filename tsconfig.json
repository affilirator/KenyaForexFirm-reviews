{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "worker-configuration.d.ts"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "types": ["./worker-configuration.d.ts"], // Add this if not present
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2024", "WebWorker", "DOM.Iterable"],
    "target": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    // "noImplicitAny": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "incremental": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@/*": ["src/*"],
      "@utils/*": ["src/utils/*"],
      "@data/*": ["src/data/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@assets/*": ["src/assets/*"],
      "@styles/*": ["src/styles/*"],
      "@pages/*": ["src/pages/*"],
      "@types/*": ["src/types/*"],
      "@content/*": ["src/content/*"],
      "@lib/*": ["src/lib/*"],
      "@onboarding/*": ["src/pages/lp/onboarding/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
